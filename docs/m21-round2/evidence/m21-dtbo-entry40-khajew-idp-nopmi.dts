			};
		};
	};

	fragment@47 {
		target = <0xffffffff>;

		__overlay__ {
			adsp-fw-bit-values = <0x01>;
			adsp-fw-names = "adsp2";
			nvmem-cell-names = "adsp_variant";
			nvmem-cells = <0xffffffff>;
		};
	};

	fragment@48 {
		target = <0xffffffff>;

		__overlay__ {
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			status = "okay";
		};
	};
};

# 脚本 verify-m21.ts:
import { validatePocketProfile, hashPocketProfile } from "./framework/src/profile.ts";
const raw = await Bun.file("./m21-profile.json").json();
const r = validatePocketProfile(raw);
if (!r.ok) { console.error(JSON.stringify(r.diagnostics, null, 1)); process.exit(1); }
console.log("pocketjs validator: OK", hashPocketProfile(r.value));

